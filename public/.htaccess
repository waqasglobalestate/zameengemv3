# Enable Options
Options -Indexes +FollowSymLinks

# Hostinger LiteSpeed / Apache Clean URL Routing & Static Asset Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Stop rewrite processing for existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # NEVER rewrite static assets (_next, .next, static, images, public) to index.html
  RewriteCond %{REQUEST_URI} ^/(_next|\.next|static|images|public)/ [NC]
  RewriteRule ^ - [L]

  # Rewrite clean route URLs to corresponding .html files if they exist (e.g. /dashboard -> /dashboard.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Fallback to index.html ONLY for page navigation routes (exclude assets and files with extensions)
  RewriteCond %{REQUEST_URI} !\.(css|js|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Set correct MIME types for CSS & JS chunks
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# Enable Browser Caching & CORS for static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|svg|webp|avif|woff2)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
