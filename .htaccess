# Enable Options
Options -Indexes +FollowSymLinks

# Hostinger LiteSpeed / Apache Clean URL Routing & Static Asset Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pass static asset paths directly
  RewriteRule ^_next/ - [L]
  RewriteRule ^\.next/ - [L]
  RewriteRule ^static/ - [L]
  RewriteRule ^images/ - [L]

  # Rewrite clean route URLs to corresponding .html files if they exist (e.g. /dashboard -> /dashboard.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Fallback to index.html for client-side routing on Next.js dynamic subpages
  RewriteRule ^ index.html [L]
</IfModule>

# Set correct MIME types for CSS & JS chunks
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# Enable Browser Caching & CORS for static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|svg|webp|avif|woff2)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
